# Локально (docker-compose поднимает свой redis-контейнер) пароль не нужен —
# в проде сюда кладут секрет с реальным паролем service-redis.
# ВАЖНО: "sentinels" должен указывать на redis-sentinel (порт 26379), а не на
# сам redis-server — userver's Redis-компонент общается по протоколу Sentinel
# даже с одним мастером (нужен для discovery топологии).
SECDIST_CONFIG={"redis_settings":{"ya_brander_jobs":{"password":"","sentinels":[{"host":"service-redis-sentinel","port":26379}],"shards":[{"name":"master0"}]}}}
