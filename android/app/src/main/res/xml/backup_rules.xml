<?xml version="1.0" encoding="utf-8"?><!--
   Правила автобэкапа (устройства до API 31).
   См. https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <!--
    Токен зашифрован ключом из Android Keystore, а ключ не бэкапится: на другом
    устройстве файл всё равно не расшифруется. Не увозим его из устройства.
    -->
    <exclude domain="sharedpref" path="auth_token_prefs.xml"/>
</full-backup-content>
